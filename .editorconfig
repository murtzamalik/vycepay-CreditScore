# EditorConfig — https://editorconfig.org

root = true

# Default for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python
[*.py]
indent_size = 4
max_line_length = 120

# TypeScript / JavaScript
[*.{ts,tsx,js,jsx}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# TOML
[*.toml]
indent_size = 4

# HTML / CSS
[*.{html,css,scss}]
indent_size = 2

# Terraform
[*.{tf,tfvars}]
indent_size = 2

# Dockerfiles
[Dockerfile*]
indent_size = 4

# Makefiles require tabs
[Makefile]
indent_style = tab

# Markdown — preserve trailing whitespace for line breaks
[*.md]
trim_trailing_whitespace = false

# Shell scripts
[*.{sh,bash}]
indent_size = 2
