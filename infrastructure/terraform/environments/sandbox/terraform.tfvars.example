# VyceScore Sandbox Environment — Example Variables
# Copy to terraform.tfvars and fill in real values. NEVER commit terraform.tfvars.

aws_region = "af-south-1"

db_master_username = "vycescore_sandbox"
db_master_password = "CHANGE_ME_use_a_strong_password"
redis_auth_token   = "CHANGE_ME_use_a_strong_token_min_16_chars"
