# VyceScore Staging Environment — Example Variables
# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars to version control.

aws_region = "af-south-1"
vpc_cidr   = "10.20.0.0/16"

db_master_username = "vycescore_admin"
db_master_password = "CHANGE_ME_use_a_strong_password"
redis_auth_token   = "CHANGE_ME_use_a_strong_token_min_16_chars"
