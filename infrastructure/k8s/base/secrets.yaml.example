# VyceScore Secrets Template
# NEVER commit real secrets to version control.
# Use an external secret manager (AWS Secrets Manager, HashiCorp Vault)
# or a Kubernetes secret operator (External Secrets Operator).
#
# This file is a template only. To create the actual secret:
#   kubectl create secret generic vycescore-secrets \
#     --namespace=vycescore \
#     --from-literal=DB_HOST=<rds-endpoint> \
#     --from-literal=DB_USERNAME=<username> \
#     --from-literal=DB_PASSWORD=<password> \
#     --from-literal=REDIS_HOST=<redis-endpoint> \
#     --from-literal=REDIS_AUTH_TOKEN=<token> \
#     --from-literal=API_MASTER_KEY=<key> \
#     --from-literal=JWT_SECRET_KEY=<key> \
#     --from-literal=SMILE_ID_API_KEY=<key> \
#     --from-literal=COMPLY_ADVANTAGE_API_KEY=<key> \
#     --from-literal=SENTRY_DSN=<dsn>
---
apiVersion: v1
kind: Secret
metadata:
  name: vycescore-secrets
  namespace: vycescore
  labels:
    app.kubernetes.io/name: vycescore
    app.kubernetes.io/part-of: vycescore-platform
type: Opaque
stringData:
  DB_HOST: "REPLACE_WITH_RDS_ENDPOINT"
  DB_USERNAME: "REPLACE_WITH_DB_USERNAME"
  DB_PASSWORD: "REPLACE_WITH_DB_PASSWORD"
  REDIS_HOST: "REPLACE_WITH_REDIS_ENDPOINT"
  REDIS_AUTH_TOKEN: "REPLACE_WITH_REDIS_AUTH_TOKEN"
  API_MASTER_KEY: "REPLACE_WITH_API_MASTER_KEY"
  JWT_SECRET_KEY: "REPLACE_WITH_JWT_SECRET"
  SMILE_ID_API_KEY: "REPLACE_WITH_SMILE_ID_KEY"
  COMPLY_ADVANTAGE_API_KEY: "REPLACE_WITH_COMPLY_ADVANTAGE_KEY"
  SENTRY_DSN: "REPLACE_WITH_SENTRY_DSN"
