# =============================================================================
# VyceScore Backend — Environment Variables
# Copy to .env and update values for your environment.
# Variables map 1:1 to backend/app/config.py (Pydantic Settings v2).
# =============================================================================

# ---- Application -----------------------------------------------------------
APP_NAME=VyceScore
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=DEBUG

# ---- Database (TimescaleDB / PostgreSQL) ------------------------------------
DATABASE_URL=postgresql+asyncpg://vycescore:vycescore_dev@localhost:5432/vycescore
DATABASE_ECHO=false

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_SCORE_TTL_SECONDS=86400

# ---- Kafka ------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- Security / Auth --------------------------------------------------------
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_HEADER=X-API-Key

# ---- CORS -------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- Scoring ----------------------------------------------------------------
SCORE_MIN=300
SCORE_MAX=900
NIQ_SCORE_MIN=0
NIQ_SCORE_MAX=100
DEFAULT_MODEL_VERSION=v1.0.0

# ---- Rate Limiting (per hour, by product tier) ------------------------------
RATE_LIMIT_LITE=120
RATE_LIMIT_PRO=60
RATE_LIMIT_BATCH=10
RATE_LIMIT_LITE_PER_HOUR=1000
RATE_LIMIT_PRO_PER_HOUR=500
RATE_LIMIT_DEEP_DIVE_PER_HOUR=200
